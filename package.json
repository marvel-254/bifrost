{
  "name": "bifrost",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight OpenAI-compatible AI gateway and intelligent model router",
  "scripts": {
    "dev": "pnpm -r --filter='@bifrost/api' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node node_modules/.pnpm/jest@29.7.0_@types+node@22.20.1/node_modules/jest/bin/jest.js --config jest.config.js packages/models/tests packages/providers/tests",
    "test:models": "node node_modules/.pnpm/jest@29.7.0_@types+node@22.20.1/node_modules/jest/bin/jest.js --config jest.config.js packages/models/tests",
    "test:providers": "node node_modules/.pnpm/jest@29.7.0_@types+node@22.20.1/node_modules/jest/bin/jest.js --config jest.config.js packages/providers/tests"
  },
  "dependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.16.0"
}
