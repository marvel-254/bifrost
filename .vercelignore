# ── Vercel deployment exclusions ──────────────────────────────────────────
# Do NOT exclude packages/ — webpack aliases in next.config.js resolve
# @bifrost/* to packages/*/src, and those source files must be uploaded.
# Vercel runs pnpm install separately, so node_modules is regenerated.

# Workspace root docs
AGENTS.md
PLAN.md
README.md

# Database (applied separately)
database/

# Tests
tests/
docs/

# Generated artifacts that Vercel regenerates
.next/
dist/

# Secrets
.env*
!.env.example

# Git
.git/

# OS files
.DS_Store
Thumbs.db
*.log
