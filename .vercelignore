# Vercel deployment exclusions
# Keep everything needed for the Next.js monorepo build.

# Root docs (not needed in deployment)
AGENTS.md
PLAN.md
README.md

# Database (applied separately, not deployed)
database/

# Tests and docs
tests/
docs/

# Generated Next.js output (regenerated by Vercel build)
.next/
dist/
out/

# Secrets
.env*
!.env.example

# Git
.git/

# OS files
.DS_Store
Thumbs.db
*.log
