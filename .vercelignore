AGENTS.md
PLAN.md
README.md

# Database — applied separately, not in deployment bundle
database/

# Tests and docs — not deployed
tests/
docs/

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Secrets
.env*
!
.env.example

# Git
.git/
