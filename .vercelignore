#
# .vercelignore — what Vercel excludes from the deployment upload
#

# Workspace root clutter (keep only apps/api)
AGENTS.md
PLAN.md
README.md

# Database (applied separately, not deployed)
database/

# Tests (not deployed)
tests/
docs/

# Dependency/cache dirs
node_modules/
.pnpm-store/
coverage/

# Logs, OS files
*.log
.DS_Store
Thumbs.db

# Environment (secrets!)
.env*
!.env.example

# Git
.git/
