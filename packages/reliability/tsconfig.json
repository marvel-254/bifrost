{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "lib": ["ES2022"],
    "types": ["jest", "node"],
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@bifrost/shared": ["../shared/src"],
      "@bifrost/models": ["../models/src"],
      "@bifrost/providers": ["../providers/src"],
      "@bifrost/routing": ["../router/src"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
